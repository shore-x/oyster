{
  "name": "oyster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "out/main/index.js",
  "description": "Agent-agnostic local knowledge hub",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && electron-vite dev",
    "electron:ensure": "node scripts/ensure-electron.mjs",
    "build": "electron-vite build && npm run prepare:design-docs",
    "lint:ui": "node scripts/check-ui-constraints.mjs",
    "prepare:design-docs": "node scripts/prepare-design-docs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "node scripts/ensure-electron.mjs && npm run build && node scripts/run-ui-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@napi-rs/keyring": "^1.3.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.12",
    "dugite": "3.2.2",
    "marked": "^18.0.7",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.15.30",
    "electron": "^42.3.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.7",
    "vitest": "^3.2.4"
  }
}
